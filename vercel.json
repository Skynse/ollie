{
  "buildCommand": "flutter build web --dart-define=APPWRITE_PROJECT_ID=$APPWRITE_PROJECT_ID --dart-define=APPWRITE_ENDPOINT=$APPWRITE_ENDPOINT --dart-define=APPWRITE_DATABASE_ID=$APPWRITE_DATABASE_ID --dart-define=APP_URL=$APP_URL --dart-define=APPWRITE_PROJECT_NAME=$APPWRITE_PROJECT_NAME",
  "outputDirectory": "build/web",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/version.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
