# Appwrite Configuration
# Copy this file to .env and fill in your actual values
# These values are used at BUILD TIME with --dart-define

APPWRITE_PROJECT_ID=your_project_id_here
APPWRITE_PROJECT_NAME=ollie
APPWRITE_ENDPOINT=https://sfo.cloud.appwrite.io/v1
APPWRITE_DATABASE_ID=your_database_id_here

# App URL for password reset redirects
# Use http://localhost:8080 for local development
# Use your production URL for production builds
APP_URL=http://localhost:8080
